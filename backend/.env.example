# LOCAL DEVELOPMENT ONLY. Generate new secrets before any deployment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-replace-with-a-random-local-secret
# Separate key for keyed fingerprints. Optional with DEBUG (falls back to the
# secret key); required, 50+ characters and different, without DEBUG.
# DJANGO_HMAC_KEY=
# Reverse proxies allowed to set X-Forwarded-Proto/For (IPs or CIDR, comma-
# separated). Leave empty locally; on the server, the Docker network of Caddy.
# DJANGO_TRUSTED_PROXIES=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
POSTGRES_DB=magistri_dev
POSTGRES_USER=magistri
POSTGRES_PASSWORD=development-only-magistri
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
