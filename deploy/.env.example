# Copy to deploy/.env on the server (git-ignored). No secrets are needed in R1.
# Hostnames Caddy serves and fetches certificates for, comma-separated.
# Staging first; add the apex (and www, if used) at cutover.
SITE_ADDRESS=staging.magistrischolae.fyi
