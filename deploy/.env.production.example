# Template only. On the server, create deploy/.env.production (git-ignored)
# with values generated there (see deploy/README.md section 9); never commit
# real values. The placeholders below are rejected at startup on purpose.
# DJANGO_HMAC_KEY is copied from deploy/.env.staging when the testers' data
# moves (R6): it fingerprints invitation tokens, so a new one would break the
# testers' unused invitation links. DJANGO_SECRET_KEY and the database
# password are new.
DJANGO_SECRET_KEY=generate-on-the-server
DJANGO_HMAC_KEY=copy-from-staging-on-the-server
DJANGO_ALLOWED_HOSTS=magistrischolae.fyi,www.magistrischolae.fyi
POSTGRES_DB=magistri_production
POSTGRES_USER=magistri
POSTGRES_PASSWORD=generate-on-the-server
