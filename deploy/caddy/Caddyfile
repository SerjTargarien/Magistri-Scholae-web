# Release R1: serves the static frontend build. R2 adds /api to Django.
# SITE_ADDRESS is set in deploy/.env, e.g.
#   staging only:  staging.magistrischolae.fyi
#   after cutover: magistrischolae.fyi, www.magistrischolae.fyi, staging.magistrischolae.fyi
# A local test uses ":80" (plain HTTP, no certificate).

{$SITE_ADDRESS} {
	root * /srv/releases/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Hashed build assets never change. A missing one is a plain 404, never
	# the app shell, so a stale browser cannot cache HTML as JavaScript.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (shell, service worker, manifest, icons, deep links)
	# revalidates on every load so a new release is picked up immediately.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
