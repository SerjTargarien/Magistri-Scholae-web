# Two sites, set in deploy/.env:
#   SITE_ADDRESS     the public site: the local-storage app (release R1),
#                    e.g. magistrischolae.fyi, www.magistrischolae.fyi
#   STAGING_ADDRESS  the account version with its own backend (release R2),
#                    e.g. staging.magistrischolae.fyi. Unset, it falls back to a
#                    placeholder that never resolves and needs no certificate.
# A local test uses SITE_ADDRESS=":80" (plain HTTP, no certificate).

# Shared behaviour for both sites.
(static_app) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Hashed build assets never change. A missing one is a plain 404, never
	# the app shell, so a stale browser cannot cache HTML as JavaScript.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (shell, service worker, manifest, icons, deep links)
	# revalidates on every load so a new release is picked up immediately.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS} {
	root * /srv/releases/current

	# www is only a signpost: send it to the main address, keeping the path.
	# Active only once www.magistrischolae.fyi is listed in SITE_ADDRESS.
	@www host www.magistrischolae.fyi
	redir @www https://magistrischolae.fyi{uri} permanent

	import static_app
}

{$STAGING_ADDRESS:http://staging.invalid} {
	root * /srv/releases-staging/current

	# The account API. Caddy sets X-Forwarded-For/Proto itself (ignoring any
	# sent by the visitor) and keeps the Host header; Django trusts them only
	# from this network (DJANGO_TRUSTED_PROXIES).
	handle /api/* {
		reverse_proxy api-staging:8000
	}

	import static_app
}
